# Copy this file to .env and fill in your values.
# .env holds secrets and should never be committed.

# --- Secrets (required) ---
COHERE_API_KEY=your-cohere-api-key-here

# --- Source document ---
PDF_PATH=Rhea_resume.pdf
DOCUMENT_SOURCE=www.rheadata.com

# --- Vector store ---
VECTOR_STORE_DIR=Vector_Store
INDEX_FILENAME=vector_db.index
DOCS_FILENAME=docs.csv

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Embeddings ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Retrieval ---
TOP_K=5
DISTANCE_THRESHOLD=1.7

# --- Cohere chat ---
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_TEMPERATURE=0.3
